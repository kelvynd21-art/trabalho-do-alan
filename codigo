<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>L'Élite Gastronomique | Reserva Exclusiva</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        :root {
            --gold: #d4af37;
            --bg: #050505;
            --card: rgba(15, 15, 15, 0.98);
            --border: rgba(212, 175, 55, 0.25);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { 
            background: var(--bg); 
            color: #fff; 
            font-family: 'Poppins', sans-serif; 
            overflow-x: hidden;
        }

        /* Background Imersivo */
        .hero-bg {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: url('https://images.unsplash.com/photo-1514362545857-3bc16c4c7d1b?q=80&w=2070&auto=format&fit=crop') no-repeat center center;
            background-size: cover; z-index: -2;
        }
        .hero-bg::after {
            content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background: linear-gradient(to bottom, rgba(0,0,0,0.7), var(--bg));
        }

        /* Nav */
        nav {
            display: flex; justify-content: space-between; align-items: center;
            padding: 25px 8%; background: rgba(0,0,0,0.95);
            border-bottom: 1px solid var(--border); position: sticky; top: 0; z-index: 1000;
        }
        .logo { font-family: 'Cinzel', serif; color: var(--gold); font-size: 1.6rem; letter-spacing: 3px; }
        .nav-links a { color: #fff; text-decoration: none; margin-left: 30px; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 2px; transition: 0.3s; }
        .nav-links a:hover { color: var(--gold); }

        .container { max-width: 1100px; margin: 60px auto; padding: 0 20px; }

        .section-header { text-align: center; margin-bottom: 50px; }
        .section-header h2 { font-family: 'Cinzel', serif; color: var(--gold); font-size: 2.2rem; }
        .section-header div { width: 60px; height: 1px; background: var(--gold); margin: 15px auto; }

        /* Menu */
        .menu-box { background: var(--card); border: 1px solid var(--border); padding: 50px; border-radius: 2px; }
        .menu-nav { display: flex; justify-content: center; gap: 30px; margin-bottom: 40px; }
        .menu-btn { 
            background: none; border: none; color: #666; font-family: 'Cinzel', serif;
            cursor: pointer; font-size: 1rem; transition: 0.3s; letter-spacing: 2px;
        }
        .menu-btn.active { color: var(--gold); border-bottom: 1px solid var(--gold); }

        .menu-items { display: none; grid-template-columns: 1fr 1fr; gap: 40px; animation: fadeIn 0.6s ease; }
        .menu-items.active { display: grid; }
        .item { border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 15px; }
        .item-head { display: flex; justify-content: space-between; margin-bottom: 5px; }
        .item-name { color: #eee; font-weight: 500; }
        .item-price { color: var(--gold); font-weight: 600; }
        .item-desc { color: #888; font-size: 0.8rem; font-style: italic; }

        /* Booking / Floor Plan */
        .booking-section { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 40px; }
        
        .floor-plan { background: var(--card); border: 1px solid var(--border); padding: 30px; }
        .grid-map { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
        .table-unit { 
            border: 1px solid var(--border); padding: 25px 10px; text-align: center; 
            cursor: pointer; transition: 0.4s; background: rgba(255,255,255,0.02);
        }
        .table-unit i { display: block; font-size: 1.4rem; color: var(--gold); margin-bottom: 10px; }
        .table-unit span { font-size: 0.7rem; color: #aaa; text-transform: uppercase; letter-spacing: 1px; }
        .table-unit:hover:not(.full) { background: rgba(212, 175, 55, 0.15); transform: translateY(-5px); }
        .table-unit.active { background: var(--gold); border-color: var(--gold); }
        .table-unit.active i, .table-unit.active span { color: #000; }
        .table-unit.full { opacity: 0.2; cursor: not-allowed; }

        /* Preview Lateral */
        .detail-preview { background: var(--card); border: 1px solid var(--border); position: sticky; top: 120px; overflow: hidden; }
        .detail-img { 
            width: 100%; height: 260px; background-size: cover; background-position: center;
            transition: 0.8s filter, 0.8s transform;
            background-image: url('https://images.unsplash.com/photo-1550966841-396ad886fe5c?q=80&w=1000');
        }
        .detail-body { padding: 30px; }
        .detail-body h3 { font-family: 'Cinzel', serif; color: var(--gold); margin-bottom: 15px; }

        input, select, .btn-main { 
            width: 100%; padding: 14px; margin-top: 15px; background: #000; 
            border: 1px solid var(--border); color: #fff; outline: none; transition: 0.3s;
        }
        input:focus { border-color: var(--gold); }
        .btn-main { 
            background: var(--gold); color: #000; font-weight: 700; border: none; 
            cursor: pointer; text-transform: uppercase; letter-spacing: 2px;
        }
        .btn-main:hover { background: #fff; letter-spacing: 4px; }

        @keyframes fadeIn { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: translateY(0); } }

        @media (max-width: 850px) {
            .booking-section, .menu-items { grid-template-columns: 1fr; }
            nav { flex-direction: column; gap: 20px; }
        }
    </style>
</head>
<body>

    <div class="hero-bg"></div>

    <nav>
        <div class="logo">L'ÉLITE</div>
        <div class="nav-links">
            <a href="#menu">Le Menu</a>
            <a href="#reserva">Reservas</a>
            <a href="#" onclick="alert('Sistema de login em manutenção.')">Acessar Conta</a>
        </div>
    </nav>

    <div class="container" id="menu">
        <div class="section-header">
            <h2>Gastronomie Française</h2>
            <div></div>
        </div>

        <div class="menu-box">
            <div class="menu-nav">
                <button class="menu-btn active" onclick="showMenu(event, 'e')">Entrées</button>
                <button class="menu-btn" onclick="showMenu(event, 'p')">Principaux</button>
                <button class="menu-btn" onclick="showMenu(event, 'd')">Desserts</button>
            </div>

            <!-- Entradas -->
            <div id="e" class="menu-items active">
                <div class="item">
                    <div class="item-head"><span class="item-name">Ostras de Santa Catarina</span><span class="item-price">R$ 125</span></div>
                    <p class="item-desc">Seis unidades frescas, servidas com granité de champanhe e chalotas.</p>
                </div>
                <div class="item">
                    <div class="item-head"><span class="item-name">Tartare de Wagyu</span><span class="item-price">R$ 145</span></div>
                    <p class="item-desc">Corte manual, gema curada em soja e alcaparras crocantes.</p>
                </div>
            </div>

            <!-- Principais -->
            <div id="p" class="menu-items">
                <div class="item">
                    <div class="item-head"><span class="item-name">Tournedos Rossini</span><span class="item-price">R$ 280</span></div>
                    <p class="item-desc">Filé mignon, foie gras grelhado, trufas frescas e redução de Madeira.</p>
                </div>
                <div class="item">
                    <div class="item-head"><span class="item-name">Risotto de Lagosta</span><span class="item-price">R$ 210</span></div>
                    <p class="item-desc">Arroz arbóreo premium, cauda de lagosta e açafrão iraniano.</p>
                </div>
            </div>

            <!-- Sobremesas -->
            <div id="d" class="menu-items">
                <div class="item">
                    <div class="item-head"><span class="item-name">Mil Folhas Royale</span><span class="item-price">R$ 58</span></div>
                    <p class="item-desc">Massa folhada artesanal com creme diplomata de baunilha Bourbon.</p>
                </div>
                <div class="item">
                    <div class="item-head"><span class="item-name">Dôme de Chocolat 70%</span><span class="item-price">R$ 62</span></div>
                    <p class="item-desc">Cúpula de chocolate belga, calda quente de caramelo e flor de sal.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="container" id="reserva">
        <div class="section-header">
            <h2>Sélection de Table</h2>
            <div></div>
        </div>

        <div class="booking-section">
            <div class="floor-plan">
                <p style="font-size: 0.7rem; color: #666; margin-bottom: 25px; text-transform: uppercase; text-align: center;">Selecione o local desejado no mapa abaixo</p>
                <div class="grid-map" id="map">
                    <!-- Gerado por JS -->
                </div>
            </div>

            <div class="detail-preview">
                <div class="detail-img" id="prevImg"></div>
                <div class="detail-body">
                    <h3 id="prevTitle">Reserve sua Mesa</h3>
                    <p id="prevText" style="font-size: 0.8rem; color: #888;">Clique em uma mesa no mapa ao lado para visualizar a ambientação exclusiva.</p>
                    
                    <form id="bookForm" style="display: none;">
                        <input type="date" id="date" required>
                        <select required>
                            <option value="">Horário Disponível</option>
                            <option>19:30</option>
                            <option>21:00</option>
                            <option>22:30</option>
                        </select>
                        <button type="submit" class="btn-main">Confirmar Reserva</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Imagens de Alta Qualidade para cada tipo de mesa
        const mesas = [
            { id: 1, tipo: 'Janela Privativa', img: 'https://images.unsplash.com/photo-1559339352-11d035aa65de?q=80&w=800' },
            { id: 2, tipo: 'Lounge Conforto', img: 'https://images.unsplash.com/photo-1551632432-c735e830171a?q=80&w=800' },
            { id: 3, tipo: 'Centro Dinâmico', img: 'https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?q=80&w=800', full: true },
            { id: 4, tipo: 'Suíte VIP', img: 'https://images.unsplash.com/photo-1466978913421-dad2ebd01d17?q=80&w=800' },
            { id: 5, tipo: 'Janela Privativa', img: 'https://images.unsplash.com/photo-1559339352-11d035aa65de?q=80&w=800' },
            { id: 6, tipo: 'Lounge Conforto', img: 'https://images.unsplash.com/photo-1551632432-c735e830171a?q=80&w=800' }
        ];

        // Gerar Mapa
        const mapEl = document.getElementById('map');
        mesas.forEach(m => {
            const div = document.createElement('div');
            div.className = `table-unit ${m.full ? 'full' : ''}`;
            div.innerHTML = `<i class="fas fa-couch"></i><span>Mesa ${m.id}</span>`;
            
            if(!m.full) {
                div.onclick = () => {
                    document.querySelectorAll('.table-unit').forEach(t => t.classList.remove('active'));
                    div.classList.add('active');
                    showPreview(m);
                };
            }
            mapEl.appendChild(div);
        });

        function showPreview(m) {
            const img = document.getElementById('prevImg');
            img.style.filter = "blur(5px)";
            setTimeout(() => {
                img.style.backgroundImage = `url('${m.img}')`;
                img.style.filter = "none";
            }, 300);
            
            document.getElementById('prevTitle').innerText = `${m.tipo} - Mesa ${m.id}`;
            document.getElementById('prevText').innerText = "Excelente escolha. O ambiente oferece privacidade e o melhor da nossa iluminação intimista.";
            document.getElementById('bookForm').style.display = 'block';
        }

        function showMenu(e, id) {
            document.querySelectorAll('.menu-items').forEach(m => m.classList.remove('active'));
            document.querySelectorAll('.menu-btn').forEach(b => b.classList.remove('active'));
            document.getElementById(id).classList.add('active');
            e.target.classList.add('active');
        }

        // Form Submit
        document.getElementById('bookForm').onsubmit = (e) => {
            e.preventDefault();
            alert('Félicitations! Sua reserva foi enviada ao concierge.');
            location.reload();
        };

        // Data min
        document.getElementById('date').min = new Date().toISOString().split("T")[0];
    </script>
</body>
</html>
